# Copy to .env when running locally (node --env-file=.env src/server.js)
PORT=3000
CURRENCY=$

# Leave blank to disable login (only do this on a trusted LAN)
APP_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Optional: a free/paid UPCitemdb key raises the barcode lookup limit (free trial is ~100/day without one)
UPCITEMDB_KEY=

# Optional AI extras (off by default). Fills item details from a photo and writes listing text.
# AI_PROVIDER=ollama | anthropic | none
AI_PROVIDER=none
# OLLAMA_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=qwen2.5vl:3b
# ANTHROPIC_API_KEY=
