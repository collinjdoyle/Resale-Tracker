# Copy to .env (docker compose reads it automatically)
PORT=3000
CURRENCY=$

# Leave blank to disable login (only do this on a trusted LAN)
APP_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Photo recognition: anthropic | ollama | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# If using ollama (needs a vision model, e.g. qwen2.5vl or llama3.2-vision)
OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_MODEL=qwen2.5vl

# Optional: UPCitemdb works without a key (rate limited); a key raises the limit
UPCITEMDB_KEY=
