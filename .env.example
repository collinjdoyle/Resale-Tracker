# Copy to .env when running locally (node --env-file=.env src/server.js)
PORT=3000
CURRENCY=$

# Leave blank to disable login (only do this on a trusted LAN)
APP_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Photo recognition + listing writer: ollama | anthropic | none
AI_PROVIDER=ollama
OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_KEEP_ALIVE=30m
AI_TIMEOUT_SECONDS=180

# Only if AI_PROVIDER=anthropic (sends photos to Anthropic, costs money)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: UPCitemdb works without a key (rate limited)
UPCITEMDB_KEY=
